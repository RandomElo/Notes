<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne sort du téléphone par sauvegarde ou transfert : le cache se retélécharge, le mot de passe se ressaisit (sa clé reste dans le Keystore). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
